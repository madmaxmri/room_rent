{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Website app (5000)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "app.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "APP_PORT": "5000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Admin app (5002)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "adminsApp.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ADMIN_PORT": "5002"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Website and Admin",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Run Website app (5000)",
        "Run Admin app (5002)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
